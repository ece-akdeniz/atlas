# Copy to .env; keep it private and out of Git. Never paste credentials into chat.
PORTAL_DOMAIN=atlas.your-domain.example
PORTAL_ORIGIN=https://atlas.your-domain.example
SECRET_KEY=replace-with-at-least-32-random-characters
# Quote this value in .env so dollar signs in the hash are literal.
PORTAL_PASSWORD_HASH='replace-with-generated-scrypt-hash'
