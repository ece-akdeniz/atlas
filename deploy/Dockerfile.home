FROM python:3.14-slim-trixie
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PORTAL_DB=/data/portal.sqlite3 PLAYWRIGHT_BROWSERS_PATH=/opt/browser-cache
WORKDIR /app
COPY requirements.lock requirements-rendering.lock ./
RUN apt-get update && apt-get install -y --no-install-recommends bubblewrap texlive-latex-extra texlive-xetex texlive-fonts-recommended poppler-utils && pip install --no-cache-dir -r requirements.lock -r requirements-rendering.lock && python -m playwright install --with-deps chromium && chmod -R a+rX /opt/browser-cache && rm -rf /var/lib/apt/lists/* && useradd --uid 10001 --create-home atlas
COPY portal ./portal
COPY scripts ./scripts
USER atlas
CMD ["gunicorn", "--bind", "0.0.0.0:8000", "--workers", "2", "--threads", "2", "--timeout", "60", "portal.app:app"]
